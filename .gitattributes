# Auto-generated files — collapse diffs and exclude from language stats
web/package-lock.json linguist-generated=true
uv.lock text eol=lf

# Enforce LF for scripts that run inside Linux containers.
# Without this, Windows checkout converts to CRLF and breaks `exec` in the
# container entrypoint with "no such file or directory".
*.sh        text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
docker/entrypoint.sh text eol=lf

# Enforce LF for all source/text files. Windows editors and tools default to
# CRLF; without normalization a Windows contributor's edit turns into a
# whole-file phantom diff (every line "changed" by its ending), breaks
# string-match patch tooling, and pollutes review. `text` normalizes to LF
# at check-in; `eol=lf` also checks out as LF so the working tree matches
# the index on every platform. PowerShell files are the deliberate
# exception (PS 5.1 tooling expects CRLF).
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.cts   text eol=lf
*.mts   text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.svg   text eol=lf
*.ps1   text eol=crlf

# --- Fork merge policy -------------------------------------------------------------
# The fork's changes to these upstream-owned files are PURE INSERTIONS: the fork only
# adds lines and never changes or removes one. Upstream rewrites these files often
# (main.ts is the busiest file in the repo), so a routine upstream edit landed on a
# fork line and the 3-way merge conflicted - which aborted `hermes update` and showed
# the GUI's "Update failed (exit 1)" banner.
#
# `merge=union` resolves such a conflict the way the fork's delta must be resolved:
# upstream's version of the file, plus the lines the fork added. Both sides' content
# survives, and neither side is silently dropped. It is git-native - no updater code,
# no change to any upstream file, and it applies to every merge path (the updater's
# own merge, a manual `git merge`, the orchestrator's).
#
# The union driver is only safe while the fork's delta on a file stays a pure
# insertion. The moment the fork CHANGES or REMOVES a line there, union would keep
# upstream's line and the fork's added block beside it - a duplicate declaration, or
# a fork change silently dropped. tests/hermes_cli/test_fork_merge_policy.py fails
# when that invariant breaks, and a file that leaves the list must be removed from it.
#
# Files whose fork delta modifies upstream lines are deliberately ABSENT: they keep
# the loud conflict, which is the only safe outcome for a genuine overlap.
/apps/desktop/electron/main.ts merge=union
/apps/desktop/electron/preload.ts merge=union
/apps/desktop/src/api/client.ts merge=union
/apps/desktop/src/app/settings/about-settings.test.tsx merge=union
/apps/desktop/src/app/settings/about-settings.tsx merge=union
/apps/desktop/src/app/settings/config-settings.test.tsx merge=union
/apps/desktop/src/app/settings/model-settings.test.tsx merge=union
/apps/desktop/src/app/settings/model-settings.tsx merge=union
/apps/desktop/src/app/settings/profile-scope.test.tsx merge=union
/apps/desktop/src/contrib/react/boundary.tsx merge=union
/apps/desktop/src/global.d.ts merge=union
/apps/desktop/src/plugins/hermes-bots/group-external-writes.test.ts merge=union
/apps/desktop/src/plugins/hermes-bots/routing.ts merge=union
/apps/desktop/src/store/updates.test.ts merge=union
/apps/desktop/src/store/updates.ts merge=union
/apps/desktop/src/types/hermes.ts merge=union
/gateway/run.py merge=union
/gateway/run_adapters.py merge=union
